# Copy this file to .env and fill it in. NEVER commit .env.

# --- Pakistan address data (provinces / cities / localities) ---------------
# Read by lib/address-db.ts (read-only). If the address tables live in the same
# Neon database as the app (current setup), use the same URL as DATABASE_URL.
ADDRESS_DATABASE_URL=""

# --- The application's own database (stores, products, orders, ...) --------
# Used by the running app (lib/db.ts). Neon pooled URL (host has "-pooler") is fine.
DATABASE_URL=""

# Used only by the Prisma CLI (db push, studio, seed). Neon DIRECT URL: turn
# "Connection pooling" OFF in the Neon Connect dialog; host has no "-pooler".
DIRECT_URL=""
