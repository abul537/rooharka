// =============================================================================
// Rooharka – multi-tenant e-commerce platform schema
//
// ONE codebase + ONE database serves MANY stores (tenants).
// Every store-owned table carries `storeId`; every query MUST filter by it.
// The platform owner's dashboard (CSMI) reads across stores.
//
// Sections
//   1. Platform & billing (CSMI)       5. Customers, visitors & analytics
//   2. Auth & audit                    6. Cart, orders, payments, shipping
//   3. Store configuration             7. Fraud prevention (phone OTP, blocklist)
//   4. Catalog & content               8. Pakistan address dataset
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ============================ ENUMS ==========================================

enum Role {
  PLATFORM_OWNER   // you
  PLATFORM_SUPPORT // your support staff (CSMI, read-mostly)
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
}

enum StoreStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
}

enum ServiceType {
  PAYMENT   // JazzCash, EasyPaisa
  COURIER   // TCS, Leopards, PostEx
  MESSAGING // SMS / WhatsApp provider used for OTP + notifications
  FEATURE   // platform features sold as add-ons (order tracking, OTP gate, ...)
}

enum PaymentPolicy {
  COD_ONLY         // pay everything on delivery
  DELIVERY_ADVANCE // customer must prepay the delivery charge, rest on delivery
  FULL_ADVANCE     // customer must prepay the full amount
  CUSTOMER_CHOICE  // customer picks any enabled option
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  DELIVERY_ADVANCE
  FULL_PAYMENT
  COD_COLLECTION
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  OTP_SENT
  OTP_VERIFIED
  ORDER_PLACED
  TRACKING_LOOKUP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_STORE
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BlockType {
  PHONE
  IP
  EMAIL
}

enum AddressType {
  HOME
  OFFICE
  SHOP
}

// ===================== 1. PLATFORM & BILLING (CSMI) ==========================

/// A tenant = one of your customers' online stores.
model Store {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique // used for <slug>.yourplatform.com
  status        StoreStatus @default(TRIAL)
  ownerName     String
  ownerEmail    String
  ownerPhone    String?
  country       String      @default("PK")
  timezone      String      @default("Asia/Karachi")
  onboardedAt   DateTime?
  suspendedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  settings      StoreSettings?
  domains       StoreDomain[]
  users         User[]
  services      StoreService[]
  subscription  Subscription?
  invoices      Invoice[]
  tickets       SupportTicket[]
  metrics       DailyStoreMetric[]
  usage         UsageRecord[]
  checkoutFields CheckoutField[]
  themes        StoreTheme[]
  contentBlocks ContentBlock[]
  media         MediaAsset[]
  categories    Category[]
  products      Product[]
  customers     Customer[]
  visitors      VisitorSession[]
  events        StoreEvent[]
  carts         Cart[]
  orders        Order[]
  verifications PhoneVerification[]
  blocklist     BlocklistEntry[]
  auditLogs     AuditLog[]

  @@index([status])
}

/// Custom domains / subdomains that route to a store.
model StoreDomain {
  id         String   @id @default(cuid())
  storeId    String
  host       String   @unique // e.g. darwaish.pk
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// Your pricing plans (what you sell to store owners).
model Plan {
  id            String   @id @default(cuid())
  name          String   @unique // Starter, Growth, Pro
  monthlyPrice  Decimal  @db.Decimal(12, 2)
  yearlyPrice   Decimal? @db.Decimal(12, 2)
  currency      String   @default("PKR")
  limits        Json     @default("{}") // { products: 50, ordersPerMonth: 500, staff: 3 }
  features      Json     @default("[]") // service keys included in the plan
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

/// One active subscription per store. Source of truth for MRR.
model Subscription {
  id                 String             @id @default(cuid())
  storeId            String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  priceOverride      Decimal?           @db.Decimal(12, 2) // negotiated price
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
}

/// What you bill each store. Paid manually (bank/JazzCash) or via gateway.
model Invoice {
  id             String        @id @default(cuid())
  storeId        String
  subscriptionId String?
  number         String        @unique // INV-2026-0001
  status         InvoiceStatus @default(OPEN)
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  lineItems      Json          @default("[]") // plan fee + service add-ons + usage
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?
  paymentRef     String?
  createdAt      DateTime      @default(now())

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([storeId, status])
  @@index([dueDate, status])
}

/// Catalogue of services you offer (jazzcash, easypaisa, tcs, leopards,
/// postex, sms-otp, whatsapp-otp, order-tracking, ...).
model ServiceCatalog {
  key          String      @id // stable identifier used in code
  name         String
  type         ServiceType
  description  String?
  platformFee  Decimal     @default(0) @db.Decimal(12, 2) // your monthly add-on fee
  requiresOwnCredentials Boolean @default(true) // store owner brings own API keys
  isActive     Boolean     @default(true)

  storeServices StoreService[]
}

/// A service switched on for a store. This is the "toggle" in settings and
/// the row CSMI watches. Credentials belong to the STORE OWNER (they pay the
/// third party); you only broker the connection.
model StoreService {
  id              String   @id @default(cuid())
  storeId         String
  serviceKey      String
  enabled         Boolean  @default(false)
  isDefault       Boolean  @default(false) // e.g. default courier
  credentialsEnc  String?  // AES-256-GCM encrypted JSON, key in env/KMS – never plaintext
  config          Json     @default("{}")  // non-secret options
  platformFee     Decimal? @db.Decimal(12, 2) // per-store override of catalog fee
  lastCheckedAt   DateTime?
  lastError       String?  // surfaced on CSMI when an integration breaks
  enabledAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceKey], references: [key])

  @@unique([storeId, serviceKey])
  @@index([serviceKey, enabled])
}

/// Metered usage (OTP messages sent, shipments created, ...) for cost and
/// billing visibility.
model UsageRecord {
  id         String   @id @default(cuid())
  storeId    String
  serviceKey String
  quantity   Int      @default(1)
  unitCost   Decimal? @db.Decimal(12, 4)
  occurredAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, serviceKey, occurredAt])
}

/// Nightly roll-up so CSMI charts load instantly instead of scanning orders.
model DailyStoreMetric {
  id            String   @id @default(cuid())
  storeId       String
  date          DateTime @db.Date
  visitors      Int      @default(0)
  orders        Int      @default(0)
  deliveredOrders Int    @default(0)
  cancelledOrders Int    @default(0)
  returnedOrders  Int    @default(0)
  revenue       Decimal  @default(0) @db.Decimal(14, 2) // GMV
  otpSent       Int      @default(0)
  otpVerified   Int      @default(0)
  errors        Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([date])
}

/// Support / communication channel between you and a store owner.
model SupportTicket {
  id         String         @id @default(cuid())
  storeId    String
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(NORMAL)
  assignedTo String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  closedAt   DateTime?

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([storeId, status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?
  fromPlatform Boolean @default(false)
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ========================= 2. AUTH & AUDIT ===================================

/// Staff accounts. storeId = null means platform staff (CSMI access).
/// Passwords: Argon2id hash only. Sessions: server-side, httpOnly cookie.
model User {
  id            String    @id @default(cuid())
  storeId       String?
  email         String    @unique
  name          String
  role          Role
  passwordHash  String
  isActive      Boolean   @default(true)
  twoFactorSecretEnc String? // TOTP secret, encrypted
  twoFactorEnabled   Boolean @default(false)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store    Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([storeId, role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique // store a hash, never the raw token
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Who changed what – every settings change, toggle and credential update.
model AuditLog {
  id         String   @id @default(cuid())
  storeId    String?
  userId     String?
  action     String   // "settings.update", "service.enable", "order.cancel"
  entity     String   // "StoreSettings"
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([userId])
}

// ===================== 3. STORE CONFIGURATION ================================

/// One row per store. Typed columns for the core switches; `extra` for the
/// long tail so new settings never need a migration.
model StoreSettings {
  storeId   String @id

  // Branding
  displayName     String
  logoUrl         String?
  faviconUrl      String?
  supportPhone    String?
  supportWhatsapp String?
  supportEmail    String?
  seoTitle        String?
  seoDescription  String?

  // Money
  currency        String @default("PKR")
  deliveryCharge  Decimal @default(0) @db.Decimal(12, 2)
  freeDeliveryOver Decimal? @db.Decimal(12, 2)

  // Payment policy
  paymentPolicy        PaymentPolicy @default(COD_ONLY)
  advanceAmountMode    String        @default("DELIVERY_CHARGE") // or FIXED / PERCENT
  advanceAmountValue   Decimal?      @db.Decimal(12, 2)

  // Fraud prevention
  phoneVerificationEnabled Boolean    @default(false)
  otpChannel               OtpChannel @default(SMS)
  otpLength                Int        @default(6)
  otpExpiryMinutes         Int        @default(5)
  otpMaxAttempts           Int        @default(5)
  /// Cap on codes sent per day for the whole store: protects the owner's SMS bill from abuse.
  otpDailyLimit            Int        @default(200)

  // Customer trust
  orderTrackingEnabled     Boolean @default(true)
  trackingRequiresPhoneLast4 Boolean @default(true) // anti-enumeration

  // Customer data / marketing
  trackVisitors            Boolean @default(true)
  requireMarketingConsent  Boolean @default(false)

  extra     Json     @default("{}")
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Per-field control of the checkout form: show/hide + required/optional.
model CheckoutField {
  id        String  @id @default(cuid())
  storeId   String
  fieldKey  String  // firstName, lastName, email, phone, province, city, locality, landmark, addressType, notes
  label     String?
  enabled   Boolean @default(true)
  required  Boolean @default(true)
  sortOrder Int     @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fieldKey])
}

/// Platform-provided theme presets (colours, fonts, radius, layout variants).
model Theme {
  id        String  @id @default(cuid())
  name      String  @unique
  tokens    Json    // { colors: {...}, fonts: {...}, radius: "..." }
  isActive  Boolean @default(true)

  storeThemes StoreTheme[]
}

/// A store's chosen preset + its own overrides. Rendered as CSS variables.
model StoreTheme {
  id        String   @id @default(cuid())
  storeId   String
  themeId   String?
  overrides Json     @default("{}")
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme Theme? @relation(fields: [themeId], references: [id])

  @@index([storeId, isActive])
}

// ===================== 4. CATALOG & CONTENT ==================================

/// Uploaded images / videos (stored in object storage; DB keeps metadata).
model MediaAsset {
  id        String    @id @default(cuid())
  storeId   String
  kind      MediaKind
  url       String
  mimeType  String
  sizeBytes Int?
  width     Int?
  height    Int?
  alt       String?
  /// Where the file lives: "cloudinary" (uploaded through the dashboard) or "external" (a pasted link).
  provider  String    @default("external")
  /// Cloudinary's id for the file; needed to delete it there. Null for external links.
  publicId  String?
  createdAt DateTime  @default(now())

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productMedia ProductMedia[]

  @@index([storeId])
}

model Category {
  id        String  @id @default(cuid())
  storeId   String
  parentId  String?
  name      String
  slug      String
  imageUrl  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
}

/// What the product page shows: name, subtitle, descriptions, SEO, status.
model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String?
  name             String
  subtitle         String?
  slug             String
  shortDescription String?
  description      String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  media      ProductMedia[]
  sections   ProductSection[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
}

/// Sizes / options with their own price and stock (30ml, 100ml, 200ml).
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String
  label          String   // "100ml"
  badge          String?  // "Most Popular"
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2) // the crossed-out price
  stock          Int      @default(0)
  trackStock     Boolean  @default(true)
  weightGrams    Int?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sku])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
}

/// Flexible product-page blocks, fully data-driven.
///   type  = how it is drawn: CHECKLIST | CARDS | STEPS | BULLETS | FAQ | KEY_BENEFITS
///   tab   = which tab it appears under (description | ingredients | usage |
///           benefits | any custom key). null for FAQ / KEY_BENEFITS.
///   items = [{ title?, text? }]
model ProductSection {
  id        String  @id @default(cuid())
  productId String
  type      String
  tab       String?
  tabLabel  String? // label shown on the tab button
  title     String
  items     Json
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Testimonials shown on the site (verified ones can link to an order).
model Review {
  id          String   @id @default(cuid())
  productId   String
  orderId     String?
  authorName  String
  city        String?
  rating      Int
  body        String
  isApproved  Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
}

/// Homepage / about / footer sections (hero, origin story, CTA, ...) edited
/// from the dashboard instead of hard-coded in components.
model ContentBlock {
  id        String  @id @default(cuid())
  storeId   String
  page      String  // home | about | footer | global
  key       String  // hero | origin-story | cta | announcement-bar
  data      Json
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, page, key])
}

// ============ 5. CUSTOMERS, VISITORS & ANALYTICS =============================

/// Profile tab 1 – personal info (verified phone is the identity key).
model Customer {
  id               String    @id @default(cuid())
  storeId          String
  phone            String    // normalised E.164, e.g. +923001234567
  phoneVerifiedAt  DateTime?
  firstName        String
  lastName         String?
  email            String?
  marketingConsent Boolean   @default(false)
  notes            String?
  firstSeenAt      DateTime  @default(now())
  lastOrderAt      DateTime?
  ordersCount      Int       @default(0) // cached for fast lists
  totalSpent       Decimal   @default(0) @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  visits    VisitorSession[]
  carts     Cart[]

  @@unique([storeId, phone])
  @@index([storeId, lastOrderAt])
}

model CustomerAddress {
  id          String      @id @default(cuid())
  customerId  String
  type        AddressType @default(HOME)
  provinceId  Int
  cityId      Int
  localityId  Int
  landmark    String?
  isDefault   Boolean     @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceId], references: [id])
  city     City     @relation(fields: [cityId], references: [id])
  locality Locality @relation(fields: [localityId], references: [id])

  @@index([customerId])
}

/// Profile tab 3 – every visit. Anonymous at first (cookie id), linked to a
/// Customer once their phone is verified.
model VisitorSession {
  id          String    @id @default(cuid())
  storeId     String
  visitorId   String    // long-lived first-party cookie
  customerId  String?
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  ipHash      String?   // hashed, not raw
  userAgent   String?
  deviceType  String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPath String?

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])
  events   StoreEvent[]
  carts    Cart[]

  @@index([storeId, visitorId])
  @@index([storeId, customerId])
  @@index([storeId, startedAt])
}

/// Funnel events: product viewed, added to cart, checkout started, ...
model StoreEvent {
  id         String    @id @default(cuid())
  storeId    String
  sessionId  String
  type       EventType
  productId  String?
  orderId    String?
  path       String?
  meta       Json?
  createdAt  DateTime  @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([storeId, type, createdAt])
  @@index([sessionId])
}

// ============= 6. CART, ORDERS, PAYMENTS, SHIPPING ===========================

/// Server-side cart; also powers abandoned-cart follow-up.
model Cart {
  id          String    @id @default(cuid())
  storeId     String
  sessionId   String?
  customerId  String?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session  VisitorSession? @relation(fields: [sessionId], references: [id])
  customer Customer?       @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([storeId, updatedAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int     @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

/// Profile tab 2 – order history. Address and prices are SNAPSHOTS so later
/// edits to products/addresses never rewrite history.
model Order {
  id            String      @id @default(cuid())
  storeId       String
  customerId    String
  number        String      // human number, unique per store: 1001, 1002...
  trackingCode  String      @unique // public, random, unguessable (e.g. DW-7K4Q-9XMD)
  status        OrderStatus @default(PLACED)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  paymentPolicy PaymentPolicy // snapshot of the rule that applied

  // Snapshot of buyer + address
  customerName  String
  customerPhone String
  customerEmail String?
  provinceName  String
  cityName      String
  localityName  String
  postalCode    String?
  landmark      String?
  addressType   AddressType @default(HOME)
  customerNote  String?

  // Money
  subtotal      Decimal @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)
  amountDue     Decimal @default(0) @db.Decimal(12, 2) // collected as COD

  // Attribution
  sessionId     String?
  utmSource     String?
  cancelledReason String?
  placedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  history   OrderStatusHistory[]
  payments  Payment[]
  shipments Shipment[]

  @@unique([storeId, number])
  @@index([storeId, status, placedAt])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String  // snapshot
  variantLabel String?
  sku         String?
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

/// Timeline shown on the public tracking page. `isPublic` lets the store
/// owner hide internal steps.
model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  status     OrderStatus
  note       String?
  isPublic   Boolean     @default(true)
  createdById String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id          String         @id @default(cuid())
  orderId     String
  method      PaymentMethod
  purpose     PaymentPurpose
  status      PaymentStatus  @default(PENDING)
  amount      Decimal        @db.Decimal(12, 2)
  providerRef String?        // JazzCash / EasyPaisa transaction id
  idempotencyKey String?     @unique // prevents double-charging on retries
  rawResponse Json?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([method, status])
}

model Shipment {
  id               String         @id @default(cuid())
  orderId          String
  courier          String         // tcs | leopards | postex (ServiceCatalog.key)
  courierTrackingNo String?
  status           ShipmentStatus @default(CREATED)
  codAmount        Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost     Decimal?       @db.Decimal(12, 2)
  labelUrl         String?
  bookedAt         DateTime       @default(now())
  deliveredAt      DateTime?
  rawResponse      Json?

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([orderId])
  @@index([courier, courierTrackingNo])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  occurredAt  DateTime

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ================== 7. FRAUD PREVENTION ======================================

/// One-time codes sent by SMS/WhatsApp before checkout. Only the HASH of the
/// code is stored.
model PhoneVerification {
  id         String     @id @default(cuid())
  storeId    String
  phone      String
  channel    OtpChannel
  codeHash   String
  attempts   Int        @default(0)
  sentAt     DateTime   @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?
  sessionId  String?
  ipHash     String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, phone, sentAt])
  @@index([expiresAt])
}

/// Numbers / IPs / emails that may not order (repeat fake-order offenders).
model BlocklistEntry {
  id        String    @id @default(cuid())
  storeId   String
  type      BlockType
  value     String
  reason    String?
  createdBy String?
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, type, value])
}

// ============= 8. PAKISTAN ADDRESS DATASET (shared, read-only) ===============
// These three models MAP onto the tables that already exist in the Neon
// database (provinces, cities, localities: 8 / 1,063 / 7,188 rows). Prisma
// reuses them as they are; nothing is renamed or reloaded.

model Province {
  id   Int    @id @default(autoincrement())
  name String @unique(map: "provinces_name_key") @db.VarChar

  cities    City[]
  addresses CustomerAddress[]

  @@map("provinces")
}

model City {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar
  provinceId Int    @map("province_id")

  province   Province          @relation(fields: [provinceId], references: [id])
  localities Locality[]
  addresses  CustomerAddress[]

  @@index([provinceId])
  @@map("cities")
}

model Locality {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar
  cityId Int    @map("city_id")

  city      City              @relation(fields: [cityId], references: [id])
  addresses CustomerAddress[]

  @@index([cityId])
  @@map("localities")
}
